classDiagram
    class GameConfig {
        +int width
        +int height
        +int lives
        +float ball_speed
        +float ball_radius
        +float paddle_width
        +float paddle_speed
        +int brick_rows
        +int brick_cols
        +float brick_width
        +float brick_height
        +float brick_padding
        +float top_margin
        +int points_per_brick
    }
    class Ball {
        +float x
        +float y
        +float vx
        +float vy
        +float radius
        +step()
        +bounce_x()
        +bounce_y()
    }
    class Paddle {
        +float x
        +float y
        +float width
        +float speed
        +move(direction: str, min_x: float, max_x: float)
    }
    class Brick {
        +float x
        +float y
        +float width
        +float height
        +int durability
        +alive() bool
        +hit() int
    }
    class Level {
        +list~Brick~ bricks
        +remaining() int
    }
    class Game {
        -GameConfig config
        -Ball ball
        -Paddle paddle
        -Level level
        -int score
        -int lives
        -str status
        +tick(input_action: str) dict
        +reset_for_life_loss()
    }
    class Collision {
        <<module>>
        +reflect_off_walls(ball: Ball, width: int, height: int)
        +collide_ball_with_paddle(ball: Ball, paddle: Paddle)
        +collide_ball_with_rect(ball: Ball, rx: float, ry: float, rw: float, rh: float) str?
    }
    Game --> GameConfig
    Game --> Ball
    Game --> Paddle
    Game --> Level
    Level --> Brick
    Level ..> GameConfig
    Collision ..> Ball
    Collision ..> Paddle
    Collision ..> Brick