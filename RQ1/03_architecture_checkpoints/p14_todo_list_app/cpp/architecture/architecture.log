ass TaskManager {\n        -ITaskStore& store_\n        -std::uint64_t next_id_\n        +explicit TaskManager(ITaskStore&)\n        +std::uint64_t create_task(const std::string&, const std::string&, const std::string&, Priority, const std::vector<std::string>&)\n        +bool edit_task(std::uint64_t, const std::string&, const std::string&, const std::string&, Priority, const std::vector<std::string>&)\n        +bool delete_task(std::uint64_t)\n        +bool set_completed(std::uint64_t, bool)\n        +std::vector<Task> list(const FilterOptions&, SortOrder) const\n        +std::pair<std::size_t, std::size_t> summarize() const\n    }\n    InMemoryTaskStore ..|> ITaskStore\n    TaskManager --> ITaskStore\n    Query --> DateRules\n    Query --> Task\n    TaskManager --> Query\n    TaskManager --> Task",
