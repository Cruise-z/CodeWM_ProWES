        +record_kill(player_id:str) None
        +score(player_id:str) int
    }
    class Game {
        +arena:Arena
        +tanks:dict[str,Tank]
        +projectiles:list[Projectile]
        +scores:ScoreBoard
        +command_queue:list[tuple[str,Command]]
        +next_projectile_id:int
        +queue_command(player_id:str, command:Command) None
        +tick() None
        +reset() None
        +winner() str|None
        +snapshot() dict
    }
