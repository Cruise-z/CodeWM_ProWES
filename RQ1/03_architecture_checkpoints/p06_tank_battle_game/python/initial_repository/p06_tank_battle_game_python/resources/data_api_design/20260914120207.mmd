    class Direction {
        <<Enum>>
        N=(0,-1)
        E=(1,0)
        S=(0,1)
        W=(-1,0)
        +delta() tuple[int,int]
        +left() Direction
        +right() Direction
    }
    class Rect {
        +x:int
        +y:int
        +w:int
        +h:int
        +contains(px:int, py:int) bool
    }
    class Obstacle {
        +rect: Rect
    }
    class Arena {
        +width:int
        +height:int
        +obstacles:list[Obstacle]
        +in_bounds(x:int,y:int) bool
        +is_blocked(x:int,y:int) bool
    }
    class Tank {
        +id:str
        +name:str
        +x:int
        +y:int
        +direction:Direction
        +health:int
        +speed:int
        +barrel_ahead() tuple[int,int]
        +alive() bool
        +clone() Tank
    }
    class Projectile {
        +pid:int
        +owner_id:str
        +x:int
        +y:int
        +direction:Direction
        +speed:int
        +move() None
        +clone() Projectile
    }
    class Command {
        <<marker>>
    }
    class MoveForward {
        +steps:int
    }
    class RotateLeft
    class RotateRight
