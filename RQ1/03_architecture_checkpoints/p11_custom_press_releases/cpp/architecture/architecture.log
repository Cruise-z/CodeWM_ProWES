ock: Clock, desc: std::string) bool\n        +publish(validator: Validator, clock: Clock, desc: std::string) bool\n        +toFieldMap() const std::map<std::string,std::string>\n        +history() const VersionHistory&\n    }\n    class Renderer {\n        +render(templateTxt: std::string, pr: PressRelease, engine: TemplateEngine) const std::string\n    }\n    class ReleaseRecord {\n        +id : std::string\n        +headline : std::string\n        +body : std::string\n        +tags : std::set<std::string>\n    }\n    class SearchIndex {\n        -records_ : std::vector<ReleaseRecord>\n        +add(rec: ReleaseRecord) void\n        +clear() void\n        +search(textQuery: std::string, requiredTags: std::set<std::string>) const std::vector<ReleaseRecord>\n    }\n    PressRelease --> VersionHistory\n    PressRelease --> Validator\n    Renderer --> TemplateEngine\n    Renderer --> PressRelease\n    VersionHistory --> Clock\n    SearchIndex --> ReleaseRecord",
