classDiagram
    class Clock {
        <<interface>>
        +now() std::string
        +~Clock()
    }
    class FixedClock {
        -timestamp : std::string
        +FixedClock(ts: std::string)
        +now() std::string
    }
    Clock <|.. FixedClock
    class VersionEntry {
        +timestamp : std::string
        +description : std::string
    }
    class VersionHistory {
        -entries_ : std::vector<VersionEntry>
        +append(clock: Clock, description: std::string) void
        +entries() const std::vector<VersionEntry>&
        +size() const std::size_t
        +toString() const std::string
    }
    class SubstitutionResult {
        +output : std::string
        +missingKeys : std::vector<std::string>
    }
    class TemplateEngine {
        +render(tmpl: std::string, fields: std::map<std::string,std::string>) const SubstitutionResult
    }
    class ValidationResult {
        +ok : bool
        +errors : std::vector<std::string>
    }
    class Validator {
        +validateFields(headline: std::string, body: std::string, email: std::string, phone: std::string) const ValidationResult
    }
    class Contact {
        +name : std::string
        +email : std::string
        +phone : std::string
    }
    class PressRelease {
        +id() const std::string
        +headline() const std::string
        +body() const std::string
        +contact() const Contact
        +state() const LifecycleState
        +tags() const std::set<std::string>&
