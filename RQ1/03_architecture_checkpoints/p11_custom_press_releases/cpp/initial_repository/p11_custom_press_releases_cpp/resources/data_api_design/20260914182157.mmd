        +publish(validator: Validator, clock: Clock, desc: std::string) bool
        +toFieldMap() const std::map<std::string,std::string>
        +history() const VersionHistory&
    }
    class Renderer {
        +render(templateTxt: std::string, pr: PressRelease, engine: TemplateEngine) const std::string
    }
    class ReleaseRecord {
        +id : std::string
        +headline : std::string
        +body : std::string
        +tags : std::set<std::string>
    }
    class SearchIndex {
        -records_ : std::vector<ReleaseRecord>
