        +setBody(value: std::string, clock: Clock, desc: std::string) void
        +setContact(contact: Contact, clock: Clock, desc: std::string) void
        +addTag(tag: std::string, clock: Clock, desc: std::string) void
        +removeTag(tag: std::string, clock: Clock, desc: std::string) void
