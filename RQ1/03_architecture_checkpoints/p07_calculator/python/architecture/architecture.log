    "Program call flow": "sequenceDiagram\n    participant T as tests\n    participant M as Main\n    participant API as calculator.api\n    participant Tok as Tokenizer\n    participant Eng as Engine\n    participant H as History\n\n    M->>API: evaluate(expr, history)\n    API->>API: validate non-blank else ParseError\n    API->>Tok: tokenize(expr)\n    Tok-->>API: tokens\n    API->>Eng: to_rpn(tokens)\n    Eng-->>API: rpn_tokens\n    API->>Eng: eval_rpn(rpn_tokens)\n    Eng-->>API: result(float)\n    API->>H: add(expr, result)\n    API-->>M: result(float)\n    T->>M: run_demo()\n    M-->>T: {\"expression\": str, \"result\": float, \"history_len\": int}",
